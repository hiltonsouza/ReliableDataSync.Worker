{
  "ConnectionStrings": {
    "ReliableDataSync": "Server=(localdb)\\MSSQLLocalDB;Database=ReliableDataSyncDb;Integrated Security=True;TrustServerCertificate=True;"
  },
  "Seed": { "Enabled": true },
  "Worker": {
    "BatchSize": 100,
    "IntervalSeconds": 30,
    "MaxRetries": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Worker.Application.UseCases": "Information",
      "Worker.Infrastructure": "Information",
      "Worker.Host": "Information"
    }
  }
}
